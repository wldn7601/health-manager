# CORS (개발 중 Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 배포 시크릿 키
DEPLOY_SECRET=change-me-to-a-random-char-string

# 이메일 발송 (SendGrid)
# sendgrid.com 가입 → Settings → API Keys → Create API Key
SENDGRID_API_KEY=SG.your_sendgrid_api_key
DEFAULT_FROM_EMAIL=your_verified_sender@gmail.com