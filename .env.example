# Django
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,wldn7601.store,www.wldn7601.store

# Database (SQLite default; override for Postgres later)
DATABASE_URL=sqlite:///db.sqlite3

# CORS (개발 중 Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 배포 시크릿 키
DEPLOY_SECRET=change-me-to-a-random-char-string

# 이메일 발송 (Gmail SMTP)
# Gmail 2단계 인증 후 앱 비밀번호 발급: myaccount.google.com → 보안 → 앱 비밀번호
EMAIL_HOST_USER=your_gmail_address@gmail.com
EMAIL_HOST_PASSWORD=your_16char_app_password
DEFAULT_FROM_EMAIL=your_gmail_address@gmail.com